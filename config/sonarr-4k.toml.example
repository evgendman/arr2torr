# Copy to /etc/torr-arr-importer/sonarr-4k.toml and edit.
# Never commit a file containing a real API key.
name = "sonarr-4k"
arr_type = "sonarr"
arr_url = "http://127.0.0.1:8990"
arr_api_key = "PUT_SONARR_4K_API_KEY_HERE"
torrserver_url = "http://127.0.0.1:8092"
category = "tv"
target_quality = 2160
state_db = "/var/lib/torr-arr-importer/state.db"
history_page_size = 1000
timeout = 30
log_level = "INFO"
log_file = "/var/log/torr-arr-importer/sonarr-4k.log"
lock_file = ""
retry_count = 2
retry_delay = 1.0
resolve_download_url = true
verification_timeout_sec = 120
verification_poll_interval_sec = 3.0
retry_backoff_sec = 60
max_add_attempts = 3

# Apprise notifications are opt-in; no requests are made while disabled.
arr_ui_url = "" # Optional browser base URL for a clickable Arr card in final alerts.
notifications_enabled = false
apprise_url = ""
apprise_config_key = "arr-stack"
service_name = "arr2torr / Sonarr 4K"
notification_timeout_sec = 5
notification_tag_critical = "critical"
notification_tag_warning = "warnings" # Legacy compatibility setting; current alerts use only critical.

# Seerr Watchlist integration: disabled until a real API key is entered.
seerr_watchlist_enabled = false
seerr_url = "http://192.168.0.14:5055"
seerr_api_key = "PUT_SEERR_API_KEY_HERE"
